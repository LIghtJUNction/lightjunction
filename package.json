{
  "name": "lightjunction-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "LightJunction — a quiet, text-first personal profile and project index",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LIghtJUNction/lightjunction.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:site && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:hero && npm run test:crypto && npm run build",
    "test:site": "node --test tests/profile.test.mjs tests/token-cloud.test.mjs",
    "test:legacy": "npm run test:game && npm run test:exploration && npm run test:shaders",
    "test:hero": "node --test tests/readme-hero.test.mjs",
    "test:crypto": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-timeout=30000 tests/age-crypto.test.mjs tests/public-key.test.mjs",
    "test:exploration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-timeout=30000 tests/expedition-*.test.mjs",
    "test:shaders": "node --test --test-timeout=30000 tests/shader-gallery.test.mjs",
    "test:game": "node --test --test-timeout=30000 tests/token-drift*.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "openpgp": "^6.3.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
