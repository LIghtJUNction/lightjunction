{
  "name": "lightjunction-profile",
  "version": "1.0.0",
  "private": true,
  "description": "LightJunction — organizations, Project Z, and encrypted contact",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/LIghtJUNction/lightjunction.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:site && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:crypto && npm run build",
    "test:site": "node --test tests/profile.test.mjs",
    "test:crypto": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-timeout=30000 tests/age-crypto.test.mjs tests/public-key.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "age-encryption": "0.3.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
